# ==========================================
# Cấu hình Ứng dụng Calories Image
# ==========================================

# 1. URL Ứng dụng
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Cấu hình Supabase (PostgreSQL, Auth & RLS)
# Lấy từ Supabase Dashboard: Project Settings -> API
# Lưu ý: Ứng dụng có sẵn chế độ Demo/Guest offline đầy đủ tính năng nếu chưa cấu hình Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-keep-private

# 3. Cấu hình AI Vision Provider (Phân tích ảnh món ăn)
# Hỗ trợ: "gemini" (Khuyên dùng, chi phí thấp/miễn phí), "openai", hoặc "mock" (chế độ giả lập kiểm thử không tốn phí)
AI_PROVIDER=gemini
AI_PROVIDER_MODEL=gemini-1.5-flash
AI_PROVIDER_API_KEY=your-gemini-or-openai-api-key
AI_PROVIDER_TIMEOUT_MS=30000

# 4. Bảo mật & Giới hạn tải ảnh
# Giới hạn kích thước tệp tải lên (MB)
MAX_ANALYSIS_FILE_SIZE_MB=5
# Tuyệt đối không lưu trữ ảnh vĩnh viễn mặc định để bảo vệ quyền riêng tư người dùng
ENABLE_IMAGE_RETENTION=false
